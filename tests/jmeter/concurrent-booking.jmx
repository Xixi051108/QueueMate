        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="User Authorization" enabled="true"><collectionProp name="HeaderManager.headers"><elementProp name="" elementType="Header"><stringProp name="Header.name">Authorization</stringProp><stringProp name="Header.value">Bearer ${userToken}</stringProp></elementProp></collectionProp></HeaderManager><hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Exactly success or slot full" enabled="true">
            <stringProp name="cacheKey">true</stringProp><stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def status = prev.getResponseCode()
def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
if (status == '201' &amp;&amp; body.code == '0') {
    props.get('bookingSuccessCount').incrementAndGet()
    prev.setSuccessful(true)
} else if (status == '409' &amp;&amp; body.code == 'BOOKING_SLOT_FULL') {
    props.get('bookingFullCount').incrementAndGet()
    prev.setSuccessful(true)
} else {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Unexpected booking response: HTTP ' + status + ' body=' + prev.getResponseDataAsString())
}
if (prev.getTime() &gt; 2000) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Booking response exceeded 2000 ms: ' + prev.getTime())
}</stringProp>
          </JSR223Assertion><hashTree/>
        </hashTree>
      </hashTree>

      <PostThreadGroup guiclass="PostThreadGroupGui" testclass="PostThreadGroup" testname="TEARDOWN - Verify and clean" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true"><boolProp name="LoopController.continue_forever">false</boolProp><stringProp name="LoopController.loops">1</stringProp></elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp><stringProp name="ThreadGroup.delay"></stringProp>
      </PostThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="VERIFY - 3 success and 9 full" enabled="true">
          <stringProp name="cacheKey">true</stringProp><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">def success = props.get('bookingSuccessCount').get()
def full = props.get('bookingFullCount').get()
if (success != 3 || full != 9) throw new AssertionError('Expected 3 success and 9 full, got success=' + success + ', full=' + full)
log.info('Concurrent booking result: success={}, full={}', success, full)</stringProp>
        </JSR223Sampler><hashTree/>

        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="VERIFY - Slot reserved count" enabled="true">
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments"><collectionProp name="Arguments.arguments"><elementProp name="dateFrom" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">dateFrom</stringProp><stringProp name="Argument.value">${__P(slotDate)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp><elementProp name="dateTo" elementType="HTTPArgument"><boolProp name="HTTPArgument.always_encode">true</boolProp><stringProp name="Argument.name">dateTo</stringProp><stringProp name="Argument.value">${__P(slotDate)}</stringProp><stringProp name="Argument.metadata">=</stringProp></elementProp></collectionProp></elementProp>
          <stringProp name="HTTPSampler.path">/api/v1/venues/${__P(venueId)}/slots</stringProp><stringProp name="HTTPSampler.method">GET</stringProp><boolProp name="HTTPSampler.follow_redirects">true</boolProp><boolProp name="HTTPSampler.use_keepalive">true</boolProp>
        </HTTPSamplerProxy>
        <hashTree>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Reserved count is exactly 3" enabled="true"><stringProp name="cacheKey">true</stringProp><stringProp name="scriptLanguage">groovy</stringProp><stringProp name="script">import groovy.json.JsonSlurper
def body = new JsonSlurper().parseText(prev.getResponseDataAsString())
def slot = body.data.find { String.valueOf(it.id) == props.get('slotId') }
if (prev.getResponseCode() != '200' || slot == null || slot.reservedCount != 3 || slot.availableCapacity != 0) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('Slot verification failed: ' + prev.getResponseDataAsString())
}</stringProp></JSR223Assertion><hashTree/>
        </hashTree>

